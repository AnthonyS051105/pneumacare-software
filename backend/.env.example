FLASK_ENV=development
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///pneumacare.db

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# Kredensial client subscriber backend SENDIRI ke broker (bukan token device) — WAJIB diisi
# begitu broker allow_anonymous false. Lihat backend/mosquitto/README.md §2.1.
MQTT_USERNAME=
MQTT_PASSWORD=

# Token statis device (INTEGRATION_CONTRACT.md §6) — dipakai sebagai bearer token /ws/audio
# DAN sebagai password MQTT user device di broker. Harus SAMA PERSIS dengan DEVICE_API_TOKEN
# di firmware include/secrets.h. Kosong = auth /ws/audio dimatikan (dev tanpa hardware).
DEVICE_AUTH_TOKEN=

# URL service ML (FastAPI lokal di ml-service/ repo ini; lihat ml-service/README.md).
# Kosong = backend memakai mock_inference tanpa mencoba koneksi HTTP.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_SECONDS=30
ML_SERVICE_MODEL_VERSION=efficientnet_b0_v1.0

# Rekaman berkala 2s: prediksi otomatis terpisah dari tren kontinu.
AUDIO_PERIODIC_SHADOW_INFERENCE_ENABLED=0
# Notifikasi audio dengan eskalasi per mikrofon berdasarkan rekaman berturut-turut.
# Memerlukan model sebenarnya; tidak membuat alert jika model tidak tersedia.
AUDIO_PERIODIC_PATIENT_ALERTS_ENABLED=1
AUDIO_PERIODIC_WARNING_CONSECUTIVE=2
AUDIO_PERIODIC_URGENT_CONSECUTIVE=3
AUDIO_PERIODIC_STREAK_MAX_GAP_SECONDS=60
