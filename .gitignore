# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# contoh konfigurasi ML service (bukan rahasia, aman di-commit)
!ml-service/.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python / flask backend
__pycache__/
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.db
backend/.pytest_cache/
backend/.coverage
backend/mosquitto/data/
backend/mosquitto/passwd
instance/
backend/instance/

# ML service (FastAPI)
ml-service/.venv/
ml-service/__pycache__/
ml-service/**/__pycache__/
ml-service/.pytest_cache/

# file checkpoint model besar (bisa ratusan MB) — tidak di-commit ke git
*.ckpt

# playwright MCP artifacts
.playwright-mcp/

# file khusus lokal
/docs/
*.local.*

# Isolated demo checkout; managed by git worktree
.worktrees/

# Generated experiment results stay local; reusable code/tests remain versioned.
/backend/benchmarks/
/artifacts/
/logs/
*.log
*.tmp
*.bak
*~

# Internal documentation stays local; README.md files remain publishable.
*.md
*.MD
*.markdown
*.mdx
!README.md

# Local model artifacts, including checkpoints delivered with archive suffixes.
*.ckpt.zip
ml-service/modules/weights/*
!ml-service/modules/weights/.gitkeep

# Private short-window audio evidence; never publish raw recordings.
backend/audio_captures/

# Private evaluation dataset supplied by the project team.
/test.zip
/data/evaluation/

# Shell launchers remain local by project policy.
*.sh
